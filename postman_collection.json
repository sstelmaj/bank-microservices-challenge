    {
      "name": "Reportes",
      "item": [
        {
          "name": "Consultar reporte PDF - febrero 2022 por cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Retorna estructura de reporte\", function () {",
                  "    pm.expect(json).to.have.property(\"clienteId\");",
                  "    pm.expect(json).to.have.property(\"fechaInicio\");",
                  "    pm.expect(json).to.have.property(\"fechaFin\");",
                  "    pm.expect(json).to.have.property(\"cuentas\");",
                  "    pm.expect(json.cuentas).to.be.an('array');",
                  "});",
                  "pm.test(\"Reporte consultado para Marianela\", function () {",
                  "    pm.expect(String(json.clienteId)).to.eql(String(pm.collectionVariables.get(\"marianelaClienteId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{cuentaMovimientoBaseUrl}}/reportes?fecha=2022-02-01,2022-02-28&clienteId={{marianelaClienteId}}",
              "host": [
                "{{cuentaMovimientoBaseUrl}}"
              ],
              "path": [
                "reportes"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "2022-02-01,2022-02-28"
                },
                {
                  "key": "clienteId",
                  "value": "{{marianelaClienteId}}"
                }
              ]
            }
          }
        }
      ]
